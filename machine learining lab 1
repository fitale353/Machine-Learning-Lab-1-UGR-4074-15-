        "\n",
        "# SECT-4451: Data Exploration & Foundational Math\n",
        "# Parts A, B, C, D, E, and F\n",
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ==========================================\n",
        "# CREATE THE DATASET (provided in the PDF)\n",
        "# ==========================================\n",
        "\n",
        "np.random.seed(42)\n",
        "n = 100\n",
        "\n",
        "study_hours = np.random.normal(5, 2, n)\n",
        "attendance = np.random.normal(85, 10, n)\n",
        "previous_mark = np.random.normal(70, 15, n)\n",
        "\n",
        "final_score = (\n",
        "    0.5 * study_hours\n",
        "    + 0.3 * attendance\n",
        "    + 0.2 * previous_mark\n",
        "    + np.random.normal(0, 5, n)\n",
        ")\n",
        "\n",
        "df = pd.DataFrame({\n",
        "    \"study_hours\": study_hours,\n",
        "    \"attendance\": attendance,\n",
        "    \"previous_mark\": previous_mark,\n",
        "    \"final_score\": final_score\n",
        "})\n",
        "\n",
        "# Add the dirty records specified in the PDF\n",
        "df.loc[0:5, \"study_hours\"] = np.nan\n",
        "df.loc[99, \"study_hours\"] = 50\n",
        "df.loc[98, \"attendance\"] = -10\n",
        "\n",
        "print(\"ORIGINAL DATA (first 10 rows)\")\n",
        "print(df.head(10))\n",
        "\n",
        "# ==========================================\n",
        "# PART A: INSPECT AND CLEAN\n",
        "# ==========================================\n",
        "\n",
        "print(\"\\nMissing values before cleaning:\")\n",
        "print(df.isnull().sum())\n",
        "\n",
        "# An attendance value of -10 is impossible.\n",
        "df.loc[df[\"attendance\"] < 0, \"attendance\"] = np.nan\n",
        "\n",
        "# Fill missing numerical values with their column median.\n",
        "df[\"study_hours\"] = df[\"study_hours\"].fillna(\n",
        "    df[\"study_hours\"].median()\n",
        ")\n",
        "df[\"attendance\"] = df[\"attendance\"].fillna(\n",
        "    df[\"attendance\"].median()\n",
        ")\n",
        "\n",
        "# Cap the 50-hour outlier at mean + 3 standard deviations,\n",
        "# calculated from study-hour values excluding the outlier.\n",
        "normal_hours = df.loc[df[\"study_hours\"] != 50, \"study_hours\"]\n",
        "upper_limit = normal_hours.mean() + 3 * normal_hours.std()\n",
        "\n",
        "df[\"study_hours\"] = df[\"study_hours\"].clip(upper=upper_limit)\n",
        "\n",
        "print(\"\\nUpper limit used for study_hours:\", round(upper_limit, 2))\n",
        "print(\"\\nCleaned data (first 10 rows)\")\n",
        "print(df.head(10))\n",
        "\n",
        "# Feature matrix and target\n",
        "X = df[[\"study_hours\", \"attendance\", \"previous_mark\"]]\n",
        "y = df[\"final_score\"]\n",
        "\n",
        "print(\"\\nFeature matrix shape:\", X.shape)\n",
        "print(\"Target shape:\", y.shape)\n",
        "print(\"Numerical feature columns:\", list(X.columns))\n",
        "print(\"Target variable: final_score\")\n",
        "\n",
        "# ==========================================\n",
        "# PART B: MEAN, MEDIAN, STANDARD DEVIATION\n",
        "# ==========================================\n",
        "\n",
        "print(\"\\nDescriptive statistics:\")\n",
        "print(df.agg([\"mean\", \"median\", \"std\"]).round(2))\n",
        "\n",
        "print(\"\\nThree observations:\")\n",
        "print(\n",
        "    \"1. Study hours vary across students, but the extreme \"\n",
        "    \"50-hour value has been capped.\"\n",
        ")\n",
        "print(\n",
        "    \"2. Attendance varies between students; a negative \"\n",
        "    \"attendance value was treated as invalid.\"\n",
        ")\n",
        "print(\n",
        "    \"3. Final scores vary because study hours, attendance, \"\n",
        "    \"previous marks, and random variation all contribute.\"\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# PART C: VISUALIZATION\n",
        "# ==========================================\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.hist(df[\"final_score\"], bins=10, edgecolor=\"black\")\n",
        "plt.title(\"Histogram of Final Scores\")\n",
        "plt.xlabel(\"Final Score\")\n",
        "plt.ylabel(\"Number of Students\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "plt.figure(figsize=(7, 4))\n",
        "plt.scatter(df[\"study_hours\"], df[\"final_score\"])\n",
        "plt.title(\"Study Hours vs Final Score\")\n",
        "plt.xlabel(\"Study Hours\")\n",
        "plt.ylabel(\"Final Score\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# ==========================================\n",
        "# PART D: CORRELATION AND CAUSALITY\n",
        "# ==========================================\n",
        "\n",
        "correlation = df[\"study_hours\"].corr(df[\"final_score\"])\n",
        "\n",
        "print(\"\\nPearson correlation:\", round(correlation, 3))\n",
        "\n",
        "print(\n",
        "    \"Interpretation: The correlation measures the direction \"\n",
        "    \"and strength of the linear relationship. It does not \"\n",
        "    \"guarantee an individual student's score.\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Possible confounding variables include prior knowledge, \"\n",
        "    \"sleep, study quality, and difficulty of the exam.\"\n",
        ")\n",
        "\n",
        "# ==========================================\n",
        "# PART E: VECTORS AND DOT PRODUCT\n",
        "# ==========================================\n",
        "\n",
        "# Select one student's feature vector, excluding final_score.\n",
        "x = df.loc[10, [\"study_hours\", \"attendance\", \"previous_mark\"]].to_numpy()\n",
        "\n",
        "w = np.array([0.5, 0.2, 0.4])\n",
        "b = 5\n",
        "\n",
        "prediction = np.dot(w, x) + b\n",
        "\n",
        "print(\"\\nSelected student feature vector:\", x.round(2))\n",
        "print(\"Weight vector:\", w)\n",
        "print(\"Bias:\", b)\n",
        "print(\"Dot product:\", round(np.dot(w, x), 2))\n",
        "print(\"y = w dot x + b:\", round(prediction, 2))\n",
        "\n",
        "# ==========================================\n",
        "# PART F: FEATURE SCALING\n",
        "# ==========================================\n",
        "\n",
        "df[\"study_hours_scaled\"] = (\n",
        "    df[\"study_hours\"] - df[\"study_hours\"].mean()\n",
        ") / df[\"study_hours\"].std()\n",
        "\n",
        "df[\"previous_mark_scaled\"] = (\n",
        "    df[\"previous_mark\"] - df[\"previous_mark\"].mean()\n",
        ") / df[\"previous_mark\"].std()\n",
        "\n",
        "print(\"\\nOriginal and standardized values:\")\n",
        "print(\n",
        "    df[[\n",
        "        \"study_hours\",\n",
        "        \"study_hours_scaled\",\n",
        "        \"previous_mark\",\n",
        "        \"previous_mark_scaled\"\n",
        "    ]].head(10).round(2)\n",
        ")\n",
        "\n",
        "print(\"\\nPROJECT COMPLETED SUCCESSFULLY!\")\n"
      ]
